#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
SCHEMA_SQL="${ROOT_DIR}/sql/schema-cleaned.sql"
MODEL_SEED_SQL="${ROOT_DIR}/sql/seed-drive-model.sql"
MODEL_ENRICH_SQL="${ROOT_DIR}/sql/seed-drive-model-enrichment.sql"

usage() {
  cat <<'USAGE'
Usage: db_setup [--no-model-seed] [--no-model-enrichment] [PSQL_DSN]

Examples:
  db_setup
  db_setup "postgresql://localhost/postgres"
  db_setup --no-model-seed "postgresql://user:pass@localhost:5432/postgres"
  db_setup --no-model-seed --no-model-enrichment

Notes:
  - Uses psql and runs with ON_ERROR_STOP=1.
  - If PSQL_DSN is omitted, defaults to "postgresql:///postgres".
  - schema-cleaned.sql creates diskstats and switches into it.
USAGE
}

seed_models=1
enrich_models=1
dsn="postgresql:///postgres"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-model-seed)
      seed_models=0
      shift
      ;;
    --no-model-enrichment)
      enrich_models=0
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      dsn="$1"
      shift
      ;;
  esac
done

if ! command -v psql >/dev/null 2>&1; then
  echo "ERROR: psql not found in PATH." >&2
  exit 1
fi

echo "==> Running schema: ${SCHEMA_SQL}"
psql "${dsn}" -v ON_ERROR_STOP=1 -f "${SCHEMA_SQL}"

if [[ "${seed_models}" -eq 1 ]]; then
  echo "==> Running optional model seed: ${MODEL_SEED_SQL}"
  psql "${dsn}" -v ON_ERROR_STOP=1 -f "${MODEL_SEED_SQL}"
else
  echo "==> Skipping model seed (--no-model-seed)"
fi

if [[ "${enrich_models}" -eq 1 ]]; then
  echo "==> Running optional model enrichment: ${MODEL_ENRICH_SQL}"
  psql "${dsn}" -v ON_ERROR_STOP=1 -f "${MODEL_ENRICH_SQL}"
else
  echo "==> Skipping model enrichment (--no-model-enrichment)"
fi

echo "==> Database setup complete."
