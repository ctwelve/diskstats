#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
SCHEMA_SQL="${ROOT_DIR}/sql/schema.sql"
MANUFACTURER_SEED_SQL="${ROOT_DIR}/sql/seed-manufacturer.sql"
MODEL_CURATED_SEED_SQL="${ROOT_DIR}/sql/seed-drive-model-curated.sql"
MODEL_ALIAS_SEED_SQL="${ROOT_DIR}/sql/seed-model-alias.sql"

usage() {
  cat <<'USAGE'
Usage: db_setup [--no-model-seed] [--no-model-alias] [PSQL_DSN]

Examples:
  db_setup
  db_setup "postgresql://localhost/postgres"
  db_setup --no-model-seed "postgresql://user:pass@localhost:5432/postgres"
  db_setup --no-model-seed --no-model-alias

Notes:
  - Uses psql and runs with ON_ERROR_STOP=1.
  - Uses PSQL_DSN from env or .env unless a positional DSN is provided.
  - schema.sql creates diskstats and switches into it.
USAGE
}

seed_models=1
seed_model_alias=1
dsn="${PSQL_DSN:-}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-model-seed)
      seed_models=0
      shift
      ;;
    --no-model-alias)
      seed_model_alias=0
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      dsn="$1"
      shift
      ;;
  esac
done

if [[ -z "${dsn}" && -f "${ROOT_DIR}/.env" ]]; then
  dsn="$(
    awk '/^[[:space:]]*PSQL_DSN[[:space:]]*=/{
      sub(/^[[:space:]]*PSQL_DSN[[:space:]]*=[[:space:]]*/, "", $0);
      print; exit
    }' "${ROOT_DIR}/.env"
  )"
  dsn="${dsn%\"}"
  dsn="${dsn#\"}"
  dsn="${dsn%\'}"
  dsn="${dsn#\'}"
fi

if ! command -v psql >/dev/null 2>&1; then
  echo "ERROR: psql not found in PATH." >&2
  exit 1
fi

if [[ -z "${dsn}" ]]; then
  echo "ERROR: set PSQL_DSN in env or ${ROOT_DIR}/.env, or pass a DSN argument." >&2
  exit 1
fi

echo "==> Running schema: ${SCHEMA_SQL}"
psql "${dsn}" -v ON_ERROR_STOP=1 -f "${SCHEMA_SQL}"

if [[ "${seed_models}" -eq 1 ]]; then
  echo "==> Running manufacturer seed: ${MANUFACTURER_SEED_SQL}"
  psql "${dsn}" -v ON_ERROR_STOP=1 -f "${MANUFACTURER_SEED_SQL}"

  echo "==> Running curated drive_model seed: ${MODEL_CURATED_SEED_SQL}"
  psql "${dsn}" -v ON_ERROR_STOP=1 -f "${MODEL_CURATED_SEED_SQL}"
else
  echo "==> Skipping model seed (--no-model-seed)"
fi

if [[ "${seed_models}" -eq 1 && "${seed_model_alias}" -eq 1 ]]; then
  echo "==> Running exact model alias seed: ${MODEL_ALIAS_SEED_SQL}"
  psql "${dsn}" -v ON_ERROR_STOP=1 -f "${MODEL_ALIAS_SEED_SQL}"
elif [[ "${seed_models}" -eq 0 ]]; then
  echo "==> Skipping model alias seed (model seed disabled)"
else
  echo "==> Skipping model alias seed (--no-model-alias)"
fi

echo "==> Database setup complete."
