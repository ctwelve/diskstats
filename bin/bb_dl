#!/usr/bin/env bash
set -euo pipefail

BASE_URL="https://f001.backblazeb2.com/file/Backblaze-Hard-Drive-Data"
START_YEAR=2016
AVAILABLE_END_YEAR=2026
AVAILABLE_END_QUARTER=2
END_YEAR="${AVAILABLE_END_YEAR}"
DRY_RUN=0

if [[ "${1:-}" == "--dry-run" ]]; then
  DRY_RUN=1
  shift
fi

if (( $# != 0 )); then
  echo "Usage: $0 [--dry-run]" >&2
  exit 2
fi

ROOT="${PWD}"
ZIPS="${ROOT}/zips"
EXTRACTED="${ROOT}/extracted"
LOGS="${ROOT}/logs"
LOADER="${ROOT}/bin/bb_load.py"

require_cmd() {
  local cmd="$1"
  if ! command -v "${cmd}" >/dev/null 2>&1; then
    echo "ERROR: required command not found in PATH: ${cmd}" >&2
    exit 1
  fi
}

if (( ! DRY_RUN )); then
  mkdir -p "$ZIPS" "$EXTRACTED" "$LOGS"
  require_cmd wget
  require_cmd zip
  require_cmd unzip
  require_cmd flock
fi

if (( ! DRY_RUN )) && [[ ! -x "${LOADER}" ]]; then
  echo "ERROR: loader not executable: ${LOADER}" >&2
  exit 1
fi

if (( ! DRY_RUN )) && [[ -z "${PSQL_DSN:-}" && -f "${ROOT}/.env" ]]; then
  PSQL_DSN="$(
    awk '/^[[:space:]]*PSQL_DSN[[:space:]]*=/{
      sub(/^[[:space:]]*PSQL_DSN[[:space:]]*=[[:space:]]*/, "", $0);
      print; exit
    }' "${ROOT}/.env"
  )"
  PSQL_DSN="${PSQL_DSN%\"}"
  PSQL_DSN="${PSQL_DSN#\"}"
  PSQL_DSN="${PSQL_DSN%\'}"
  PSQL_DSN="${PSQL_DSN#\'}"
fi

if (( ! DRY_RUN )); then
  : "${PSQL_DSN:?Set PSQL_DSN in env or ${ROOT}/.env (e.g. PSQL_DSN='postgresql://.../diskstats')}"
fi

if (( ! DRY_RUN )); then
  # prevent accidental concurrent runs
  exec 9>"${ROOT}/state.lock"
  flock -n 9 || { echo "bb_dl: already running"; exit 0; }

  # log everything
  LOGFILE="${LOGS}/pipeline_$(date -u +%Y%m%dT%H%M%SZ).log"
  exec > >(tee -a "$LOGFILE") 2>&1
fi

echo "==> Backblaze pipeline starting at $(date -u)"
echo "==> ROOT=$ROOT"
echo "==> Years ${START_YEAR}..${END_YEAR}"
echo "==> Target through Q${AVAILABLE_END_QUARTER} ${AVAILABLE_END_YEAR}"

if (( AVAILABLE_END_YEAR < START_YEAR )); then
  echo "==> No available quarters in requested range; exiting."
  exit 0
fi

for year in $(seq "$START_YEAR" "$END_YEAR"); do
  for quarter in 1 2 3 4; do
    if (( year > AVAILABLE_END_YEAR || (year == AVAILABLE_END_YEAR && quarter > AVAILABLE_END_QUARTER) )); then
      continue
    fi

    ZIP_NAME="data_Q${quarter}_${year}.zip"
    ZIP_PATH="${ZIPS}/${ZIP_NAME}"

    if (( DRY_RUN )); then
      echo "${BASE_URL}/${ZIP_NAME}"
      continue
    fi

    TARGET_DIR="${EXTRACTED}/data_Q${quarter}_${year}"
    TMP_DIR="${TARGET_DIR}.tmp"

    echo
    echo "==> ${ZIP_NAME}"

    # download if missing
    if [[ ! -f "$ZIP_PATH" ]]; then
      echo "    downloading -> $ZIP_PATH"
      if ! wget --continue -O "$ZIP_PATH" "${BASE_URL}/${ZIP_NAME}"; then
        rm -f "$ZIP_PATH"
        if (( year == AVAILABLE_END_YEAR && quarter == AVAILABLE_END_QUARTER )); then
          echo "    warning: ${ZIP_NAME} not available yet; skipping"
          continue
        fi
        echo "    ERROR: download failed: ${ZIP_NAME}" >&2
        exit 1
      fi
    else
      echo "    zip present"
    fi

    # sanitize zip (don't fail if pattern not present)
    echo "    sanitizing zip (__MACOSX/*)"
    zip -d "$ZIP_PATH" "__MACOSX/*" >/dev/null 2>&1 || true

    # extract if needed
    if [[ -d "$TARGET_DIR" ]]; then
      echo "    already extracted -> $TARGET_DIR"
    else
      echo "    extracting -> $TARGET_DIR"
      rm -rf "$TMP_DIR"
      mkdir -p "$TMP_DIR"
      unzip -q "$ZIP_PATH" -d "$TMP_DIR"

      # sanity check (portable, case-insensitive .csv)
      if ! find "$TMP_DIR" -type f -print 2>/dev/null | grep -Eiq '\.csv$'; then
        echo "    ERROR: no CSVs found after unzip: $ZIP_PATH"
        echo "    debug: extracted sample entries:"
        find "$TMP_DIR" -maxdepth 3 -mindepth 1 -print 2>/dev/null | sed -n '1,10p' || true
        rm -rf "$TMP_DIR"
        exit 1
      fi

      mv "$TMP_DIR" "$TARGET_DIR"
      echo "    extracted"
    fi

    # ingest (bb_load is resumable; safe to re-run)
    echo "    ingesting -> Postgres"
    "${LOADER}" "$PSQL_DSN" "$TARGET_DIR"

    echo "    done"
  done
done

echo
echo "==> Backblaze pipeline finished at $(date -u)"
if (( ! DRY_RUN )); then
  echo "==> Log: $LOGFILE"
fi
