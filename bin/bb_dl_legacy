#!/usr/bin/env bash
set -euo pipefail

BASE_URL="https://f001.backblazeb2.com/file/Backblaze-Hard-Drive-Data"

ROOT="${PWD}"
ZIPS="${ROOT}/zips"
EXTRACTED="${ROOT}/extracted"
LOGS="${ROOT}/logs"
LOADER="${ROOT}/bin/bb_load.py"

require_cmd() {
  local cmd="$1"
  if ! command -v "${cmd}" >/dev/null 2>&1; then
    echo "ERROR: required command not found in PATH: ${cmd}" >&2
    exit 1
  fi
}

mkdir -p "$ZIPS" "$EXTRACTED" "$LOGS"

require_cmd wget
require_cmd zip
require_cmd unzip
require_cmd flock

if [[ ! -x "${LOADER}" ]]; then
  echo "ERROR: loader not executable: ${LOADER}" >&2
  exit 1
fi

if [[ -z "${PSQL_DSN:-}" && -f "${ROOT}/.env" ]]; then
  PSQL_DSN="$(
    awk '/^[[:space:]]*PSQL_DSN[[:space:]]*=/{
      sub(/^[[:space:]]*PSQL_DSN[[:space:]]*=[[:space:]]*/, "", $0);
      print; exit
    }' "${ROOT}/.env"
  )"
  PSQL_DSN="${PSQL_DSN%\"}"
  PSQL_DSN="${PSQL_DSN#\"}"
  PSQL_DSN="${PSQL_DSN%\'}"
  PSQL_DSN="${PSQL_DSN#\'}"
fi

: "${PSQL_DSN:?Set PSQL_DSN in env or ${ROOT}/.env (e.g. PSQL_DSN='postgresql://.../diskstats')}"

# prevent concurrent runs (legacy + quarterly colliding, etc.)
exec 9>"${ROOT}/state.lock"
flock -n 9 || { echo "bb_dl_legacy: another downloader is already running"; exit 0; }

# log everything
LOGFILE="${LOGS}/legacy_pipeline_$(date -u +%Y%m%dT%H%M%SZ).log"
exec > >(tee -a "$LOGFILE") 2>&1

echo "==> Backblaze LEGACY pipeline starting at $(date -u)"
echo "==> ROOT=$ROOT"
echo "==> Log: $LOGFILE"

LEGACY_ZIPS=(
  "data_2013.zip"
  "data_2014.zip"
  "data_2015.zip"
)

for ZIP_NAME in "${LEGACY_ZIPS[@]}"; do
  ZIP_PATH="${ZIPS}/${ZIP_NAME}"

  # We'll extract into extracted/data_2013, extracted/data_2014, etc.
  # (strip ".zip")
  BASE_NAME="${ZIP_NAME%.zip}"
  TARGET_DIR="${EXTRACTED}/${BASE_NAME}"
  TMP_DIR="${TARGET_DIR}.tmp"

  echo
  echo "==> ${ZIP_NAME}"

  # download if missing
  if [[ ! -f "$ZIP_PATH" ]]; then
    echo "    downloading -> $ZIP_PATH"
    wget --continue -O "$ZIP_PATH" "${BASE_URL}/${ZIP_NAME}"
  else
    echo "    zip present"
  fi

  # sanitize zip (don't fail if pattern not present)
  echo "    sanitizing zip (__MACOSX/*)"
  zip -d "$ZIP_PATH" "__MACOSX/*" >/dev/null 2>&1 || true

  # extract if needed
  if [[ -d "$TARGET_DIR" ]]; then
    echo "    already extracted -> $TARGET_DIR"
  else
    echo "    extracting -> $TARGET_DIR"
    rm -rf "$TMP_DIR"
    mkdir -p "$TMP_DIR"
    unzip -q "$ZIP_PATH" -d "$TMP_DIR"

    # sanity check: ensure directory contains CSVs somewhere (portable, case-insensitive)
    if ! find "$TMP_DIR" -type f -print 2>/dev/null | grep -Eiq '\.csv$'; then
      echo "    ERROR: no CSVs found after unzip: $ZIP_PATH"
      echo "    debug: extracted sample entries:"
      find "$TMP_DIR" -maxdepth 3 -mindepth 1 -print 2>/dev/null | sed -n '1,10p' || true
      rm -rf "$TMP_DIR"
      exit 1
    fi

    mv "$TMP_DIR" "$TARGET_DIR"
    echo "    extracted"
  fi

  # ingest (bb_load is resumable per-file via ingest_log)
  echo "    ingesting -> Postgres"
  "${LOADER}" "$PSQL_DSN" "$TARGET_DIR"

  echo "    done"
done

echo
echo "==> Backblaze LEGACY pipeline finished at $(date -u)"
echo "==> Log: $LOGFILE"
